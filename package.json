{
  "name": "schemo",
  "version": "1.3.0",
  "description": "Schémo — diagrammes qui se rangent tout seuls",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && electron . --no-sandbox",
    "test": "node test/layout.test.mjs && node test/markdown.test.mjs",
    "dist": "bash scripts/package-win.sh",
    "nouvelle-update": "node scripts/nouvelle-update.mjs"
  },
  "keywords": [],
  "author": "LeEvSa",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "elkjs": "^0.12.1",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.1"
  },
  "private": true,
  "build": {
    "appId": "ca.leevsa.schemo",
    "productName": "Schemo",
    "copyright": "LeEvSa",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "electron/**",
      "app/**",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "asar": true,
    "electronLanguages": [
      "fr",
      "fr-CA",
      "en-US"
    ],
    "compression": "normal",
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "Schemo.exe"
    },
    "portable": {
      "artifactName": "Schemo.exe"
    },
    "extraMetadata": {
      "main": "electron/main.cjs"
    }
  }
}
